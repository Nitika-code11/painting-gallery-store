# Settings for docker compose. Copy this file to ".env" (which git ignores) and edit it.
# With no .env at all, `docker compose up` runs the local "dev" profile.

# Which Spring profile the backend runs. "dev" = sample data, API docs, H2 console, throwaway admin account.
# Anything else (e.g. "prod") = none of those, and the secrets below are REQUIRED.
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL, started by docker compose; data lives in the "pgdata" volume).
# The defaults work for a local run. Set your own password for anything shared, BEFORE the first start:
# the database user is created only when the volume is empty, so changing the password later needs
#   docker compose down -v      (this DELETES the stored data)
DB_NAME=paintings
DB_USERNAME=painting
DB_PASSWORD=painting_dev_password

# Required when SPRING_PROFILES_ACTIVE is not "dev". At least 32 characters; generate one with:
#   openssl rand -base64 48
# Never commit a real value, and use a different one in every environment.
APP_JWT_SECRET=

# The first administrator account, created at startup if it does not exist yet.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Browser origins allowed to call the API directly (not needed when everything goes through the frontend on :3000).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to false to build a read-only site with no sign-in or admin screens.
VITE_ENABLE_MUTATIONS=true
